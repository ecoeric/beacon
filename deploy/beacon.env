# Beacon API configuration (consumed by beacon-api.service and beacon-retention.service).
# Values verified against this host during Phase 1 discovery — see docs/phase1-discovery.md.
BEACON_DATA_DIR=/home/eric/beacon/data
BEACON_BIND=192.168.1.83
BEACON_PORT=8091
BEACON_TLS_CERT=/home/eric/beacon/data/tls/server.crt
BEACON_TLS_KEY=/home/eric/beacon/data/tls/server.key

# Where the dashboard finds the active agent (read-only).
BEACON_CHERRY_DB=/home/eric/.config/CherryStudio/Data/cherrystudio.sqlite
BEACON_CHERRY_AGENTS_DIR=/home/eric/.config/CherryStudio/Data/Agents
BEACON_AGENT_ID=cc33efa9-6b9f-41f0-bf75-86dbc6e27096
BEACON_SESSION_ID=
BEACON_STALE_WORKING_SECONDS=90
BEACON_STALE_DISCONNECT_SECONDS=86400

# Pi-hole v6 API (existing container; password imported by `beacon init`).
BEACON_PIHOLE_URL=http://192.168.1.83:8080
BEACON_PIHOLE_PASSWORD_FILE=/home/eric/beacon/data/secrets/pihole.password
BEACON_PIHOLE_TIMEOUT_SECONDS=3

# Existing NeoForge installation.
BEACON_MINECRAFT_DIR=/home/eric/Desktop/NeoForgeServer
BEACON_MINECRAFT_HOST=127.0.0.1
BEACON_MINECRAFT_PORT=25565
BEACON_MINECRAFT_LAUNCH_SCRIPT=run.sh
BEACON_MINECRAFT_RCON_PASSWORD_FILE=/home/eric/beacon/data/secrets/minecraft.rcon
BEACON_MINECRAFT_STOP_TIMEOUT_SECONDS=120

# Read-only Docker visibility: a root timer writes this snapshot; the API only reads it.
BEACON_DOCKER_SNAPSHOT_FILE=/run/beacon/docker.json

# Message delivery leases (redelivery when an agent dies mid-checkpoint).
BEACON_MESSAGE_LEASE_SECONDS=120
BEACON_MESSAGE_MAX_ATTEMPTS=5

# Request size ceiling (multipart uploads are additionally limited per file).
BEACON_MAX_REQUEST_BYTES=67108864

# Screenshots.
BEACON_SCREENSHOT_RETENTION_DAYS=7
BEACON_SCREENSHOT_MAX_BYTES=12582912
BEACON_SCREENSHOT_MAX_TOTAL_BYTES=536870912

# Genuine X11 window captures (ffmpeg x11grab) for desktop applications.
BEACON_X11_DISPLAY=:0
BEACON_X11_AUTHORITY=/home/eric/.Xauthority

# API docs stay off by default; the committed docs/openapi.json is the reference.
BEACON_ENABLE_DOCS=0
