[Unit]
Description=Beacon dashboard API (FastAPI + SQLite) for the native iOS app
Documentation=file:///home/eric/beacon/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eric
Group=eric
WorkingDirectory=/home/eric/beacon/backend
EnvironmentFile=/home/eric/beacon/deploy/beacon.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/home/eric
ExecStart=/home/eric/beacon/backend/.venv/bin/uvicorn beacon.asgi:app \
    --host ${BEACON_BIND} --port ${BEACON_PORT} \
    --ssl-certfile ${BEACON_TLS_CERT} --ssl-keyfile ${BEACON_TLS_KEY} \
    --no-server-header --timeout-keep-alive 75
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT

# Hardening notes:
#  * The API never runs `sudo` and never touches the Docker socket: Docker metrics come from
#    /run/beacon/docker.json, written by the root `beacon-docker.timer` with two fixed commands.
#    That allows NoNewPrivileges=yes here, so a compromised API process cannot exec setuid sudo
#    even though the interactive `eric` account has a NOPASSWD rule.
#  * PrivateTmp is OFF so `ffmpeg -f x11grab` can reach /tmp/.X11-unix for real window captures.
#  * PrivateDevices is OFF because nvidia-smi needs /dev/nvidia*.
#  * The service still runs as `eric` and can read the Cherry Studio database; credentials that
#    have nothing to do with Beacon are masked with InaccessiblePaths below.
NoNewPrivileges=yes
InaccessiblePaths=-/home/eric/.ssh -/home/eric/.gnupg -/home/eric/.mozilla -/home/eric/.config/CherryStudio/Credentials
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/eric/beacon/data /home/eric/Desktop/NeoForgeServer /home/eric/.config/CherryStudio/Data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# NOTE: an IPAddressDeny/Allow egress allow-list was trialled and reverted: with it in place the
# service could not reach Pi-hole on the same host, so it is not a safe control for this
# deployment. Network exposure is instead limited by binding to the LAN address only.
# Only native syscalls, and hide processes of other users from /proc (we only read our own).
SystemCallArchitectures=native
ProtectProc=invisible
MemoryMax=1G
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
