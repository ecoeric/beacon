#!/usr/bin/env python3
"""Write a read-only Docker snapshot for the Beacon dashboard.

Runs as root from `beacon-docker.service` (a timer every 15 s). The API process never runs
`sudo` and never talks to the Docker socket: it only reads this JSON file. The two docker
commands are fixed argv, so this script cannot be turned into an arbitrary docker client.

Output (atomic replace, mode 0644):
    {"fetched_at": 1794..., "containers": [{"name": ..., "image": ..., ...}]}
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
import time

DOCKER = "/usr/bin/docker"
OUTPUT = "/run/beacon/docker.json"
MEMORY_UNITS = {"B": 1, "KIB": 1024, "MIB": 1024**2, "GIB": 1024**3, "TIB": 1024**4}


def docker(*args: str) -> str:
    return subprocess.run(
        [DOCKER, *args],
        capture_output=True,
        text=True,
        timeout=25,
        check=True,
        env={
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "DOCKER_CONFIG": "/run/beacon/docker-config",
            "HOME": "/run/beacon",
        },
    ).stdout


def parse_bytes(value: str) -> int | None:
    match = re.match(r"^\s*([0-9.]+)\s*([KMGT]?i?B)\s*$", value.strip(), re.IGNORECASE)
    if not match:
        return None
    factor = MEMORY_UNITS.get(match.group(2).upper())
    return int(float(match.group(1)) * factor) if factor else None


def parse_percent(value: str) -> float | None:
    try:
        return round(float(value.strip().rstrip("%")), 2)
    except (TypeError, ValueError):
        return None


def collect() -> list[dict]:
    containers: dict[str, dict] = {}
    for line in docker("ps", "-a", "--no-trunc", "--format", "{{json .}}").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            data = json.loads(line)
        except ValueError:
            continue
        status = data.get("Status", "")
        health = None
        if "(healthy)" in status:
            health = "healthy"
        elif "(unhealthy)" in status:
            health = "unhealthy"
        elif "health: starting" in status:
            health = "starting"
        containers[data.get("Names", "")] = {
            "name": data.get("Names", ""),
            "image": data.get("Image", ""),
            "state": (data.get("State") or "unknown").lower(),
            "status": status,
            "health": health,
            "cpu_percent": None,
            "memory_bytes": None,
            "memory_limit_bytes": None,
            "started_at": None,
            "error": None,
        }
    try:
        stats_output = docker("stats", "--no-stream", "--format", "{{json .}}")
    except subprocess.SubprocessError:
        stats_output = ""
    for line in stats_output.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            data = json.loads(line)
        except ValueError:
            continue
        name = data.get("Name") or data.get("Container") or ""
        entry = containers.get(name)
        if entry is None:
            continue
        entry["cpu_percent"] = parse_percent(data.get("CPUPerc", ""))
        usage = data.get("MemUsage", "")
        if "/" in usage:
            used, _, limit = usage.partition("/")
            entry["memory_bytes"] = parse_bytes(used)
            entry["memory_limit_bytes"] = parse_bytes(limit)
    return list(containers.values())


def main() -> int:
    os.makedirs(os.path.dirname(OUTPUT), mode=0o755, exist_ok=True)
    os.makedirs("/run/beacon/docker-config", mode=0o755, exist_ok=True)
    try:
        containers = collect()
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"docker snapshot failed: {exc}", file=sys.stderr)
        return 1
    payload = {"fetched_at": time.time(), "containers": containers}
    directory = os.path.dirname(OUTPUT)
    fd, temporary = tempfile.mkstemp(dir=directory, prefix=".docker-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, separators=(",", ":"))
        os.chmod(temporary, 0o644)
        os.replace(temporary, OUTPUT)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return 0


if __name__ == "__main__":
    sys.exit(main())
