[Unit]
Description=Beacon Docker snapshot (read-only, for the dashboard)
Documentation=file:///home/eric/beacon/docs/OPERATIONS.md
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/beacon/docker-snapshot
RuntimeDirectory=beacon
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=60

# This is the only privileged piece of the dashboard. It runs two fixed docker commands and
# writes one file; it cannot be asked to do anything else. The API itself never runs sudo.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/run/docker.sock
ReadWritePaths=/run/beacon
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=256M
TasksMax=32
